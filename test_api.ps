# test_api.ps1
Write-Host "🔍 Probando conexión con la API..." -ForegroundColor Cyan

try {
    # 1. Probar que el servidor responde
    Write-Host "`n1️⃣ Verificando que el servidor está corriendo..." -ForegroundColor Yellow
    $health = Invoke-WebRequest -Method GET -Uri "http://localhost:8000/" -ErrorAction Stop
    Write-Host "✅ Servidor corriendo correctamente" -ForegroundColor Green
    Write-Host "📄 Respuesta: $($health.Content)" -ForegroundColor Gray
} catch {
    Write-Host "❌ ERROR: El servidor no está corriendo en http://localhost:8000" -ForegroundColor Red
    Write-Host "💡 Ejecuta: uvicorn main:app --reload" -ForegroundColor Yellow
    exit 1
}

# 2. Probar registro de usuario
Write-Host "`n2️⃣ Registrando usuario..." -ForegroundColor Yellow
try {
    $registerBody = @{
        email = "vendedor@email.com"
        password = "password123"
        nombre = "Vendedor Test"
        id_empresa = "agencia-playa-01"
    } | ConvertTo-Json

    $register = Invoke-WebRequest -Method POST `
        -Uri "http://localhost:8000/api/v1/auth/register" `
        -Headers @{"Content-Type" = "application/json"} `
        -Body $registerBody `
        -ErrorAction Stop

    Write-Host "✅ Registro exitoso" -ForegroundColor Green
    $registerData = $register.Content | ConvertFrom-Json
    Write-Host "📧 Usuario: $($registerData.user.email)" -ForegroundColor Gray
} catch {
    Write-Host "⚠️  Error en registro (puede que el usuario ya exista): $($_.Exception.Message)" -ForegroundColor Yellow
}

# 3. Login
Write-Host "`n3️⃣ Iniciando sesión..." -ForegroundColor Yellow
try {
    $loginBody = @{
        email = "vendedor@email.com"
        password = "password123"
    } | ConvertTo-Json

    $login = Invoke-WebRequest -Method POST `
        -Uri "http://localhost:8000/api/v1/auth/login" `
        -Headers @{"Content-Type" = "application/json"} `
        -Body $loginBody `
        -ErrorAction Stop

    Write-Host "✅ Login exitoso" -ForegroundColor Green
    $loginData = $login.Content | ConvertFrom-Json
    $token = $loginData.access_token
    Write-Host "🔑 Token: $($token.Substring(0, 30))..." -ForegroundColor Gray
} catch {
    Write-Host "❌ Error en login: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}

# 4. Obtener perfil
Write-Host "`n4️⃣ Obteniendo perfil..." -ForegroundColor Yellow
try {
    $profile = Invoke-WebRequest -Method GET `
        -Uri "http://localhost:8000/api/v1/auth/me" `
        -Headers @{
            "Authorization" = "Bearer $token"
            "Content-Type" = "application/json"
        } `
        -ErrorAction Stop

    Write-Host "✅ Perfil obtenido" -ForegroundColor Green
    $profileData = $profile.Content | ConvertFrom-Json
    Write-Host "📧 Email: $($profileData.email)" -ForegroundColor White
    Write-Host "👤 Nombre: $($profileData.nombre)" -ForegroundColor White
    Write-Host "🏢 Empresa: $($profileData.id_empresa)" -ForegroundColor White
} catch {
    Write-Host "❌ Error obteniendo perfil: $($_.Exception.Message)" -ForegroundColor Red
}

Write-Host "`n✅ Prueba completada!" -ForegroundColor Green